  %Image::ExifTool::UserDefined = (

    'Image::ExifTool::Composite' => {

        StackedImageCustom => { # Merge GND filter densitiy and type into one value
            Require => {
                0 => 'StackedImage',
            },
            Desire => {
                1 => 'GNDFilterType',
            },
            PrintConv => '"$prt[0] $prt[1]"',
        },

        MeteringModeFP => {
            Desire => {
                0 => 'Canon:MeteringMode',
                1 => 'Nikon:MeteringMode',
                2 => 'Olympus:MeteringMode',
                3 => 'Sony:MeteringMode2',
                4 => 'Sony:MeteringMode',
                5 => 'EXIF:MeteringMode',
            },
            PrintConv => q{
                defined $prt[0] ? $prt[0] :
                defined $prt[1] ? $prt[1] :
                defined $prt[2] ? $prt[2] :
                defined $prt[3] ? $prt[3] :
                defined $prt[4] ? $prt[4] :
                $prt[5]
            },
        },

        ExposureModeFP => {
            Desire => {
                0 => 'Canon:CanonExposureMode',
                1 => 'Olympus:ExposureMode',
                2 => 'Sony:ExposureProgram',
                3 => 'EXIF:ExposurePrograme',
            },
            PrintConv => q{
                defined $prt[0] ? $prt[0] :
                defined $prt[1] ? $prt[1] :
                defined $prt[2] ? $prt[2] :
                $prt[3]
            },
        },

    },


   'Image::ExifTool::FujiFilm::Main' => {

        0x1403 => { #2 (only valid for manual DR, ref 6)
          Name => 'DevelopmentDynamicRange',
          Writable => 'int16u',
          # (shows 200, 400 or 800 for HDR200,HDR400,HDR800, ref forum10799)
          PrintConv => '"$val%"',
        }
    },


    'Image::ExifTool::Olympus::Main' => {
    },


    'Image::ExifTool::Olympus::CameraSettings' => {

        0x0305 => { # Overwrite original printconv with output of the rational numbers
            Name => 'AFPointSelected',
            Writable => 'rational64s',
            Count => 5,
            ValueConv => '$val =~ s/\S* //; $val', # ignore first undefined value
            PrintConv => q{
                my @a = split ' ', $val;
                sprintf("%.4g %.4g",$a[0],$a[1]);
            },
        },
    },


    'Image::ExifTool::Olympus::ImageProcessing' => {

        0x1201 => { # Include this tag in standard output
            Name => 'FaceDetectArea',
            Writable => 'int16s',
            Count => -1, # (varies with model)
        },
    },


    'Image::ExifTool::Olympus::FocusInfo' => {

        0x0328 => {
            Name => 'AFInfoBin',
            Writable => 'int8u',
            Count => -1,
        },

    },


    'Image::ExifTool::Olympus::AFInfo' => {
    },


    'Image::ExifTool::Pentax::Main' => {
    },


    'Image::ExifTool::Pentax::TempInfo' => {
    },


    'Image::ExifTool::Pentax::AFInfo' => {
    },


    'Image::ExifTool::Panasonic::Main' => {

        0x4d => { # Overwrite original printconv by using 4 digits instead of 2 for the coordinates
            Name => 'AFPointPosition',
            Writable => 'rational64u',
            Count => 2,
            Notes => 'X Y coordinates of primary AF area center, in the range 0.0 to 1.0',
            PrintConv => q{
                return 'none' if $val eq '16777216 16777216';
                return 'n/a' if $val =~ /^4194303\.9/;
                my @a = split ' ', $val;
                sprintf("%.4g %.4g",@a);
            },
            PrintConvInv => q{
                return '16777216 16777216' if $val eq 'none';
                return '4294967295/1024 4294967295/1024' if $val eq 'n/a';
                return $val;
            },
         },
    },

    'Image::ExifTool::Panasonic::Leica5' => {

        0x0404 => { # AF configuration
            Name => 'AFConfiguration',
            Writable => 'int8u',
            Count => 4,
            Notes => 'AF configuration: b0 = area mode, b1 = macro mode, b2 = detection, b3 = focus mode',
            PrintConv => q{
                my @a = split ' ', $val;

                my %area = (
                    0  => 'MF',
                    9  => 'Tracking',
                    15 => 'Spot or Large',
                    16 => 'Multi Zone',
                );

                my %macro = (
                    0 => 'Normal',
                    1 => 'Macro',
                );

                my %detect = (
                    0 => 'None',
                    1 => 'People',
                    2 => 'Face+Eye',
                    3 => 'Animal',
                    4 => 'Animal+Eye',
                );

                my %focus = (
                    0 => 'MF',
                    1 => 'AF-S',
                    2 => 'AF-C',
                    4 => 'iAF',
                );

                return sprintf('%s, %s, %s, %s',
                    defined $area{$a[0]}   ? $area{$a[0]}   : "Unknown($a[0]",
                    defined $macro{$a[1]}  ? $macro{$a[1]}  : "Unknown($a[1]",
                    defined $detect{$a[2]} ? $detect{$a[2]} : "Unknown($a[2]",
                    defined $focus{$a[3]}  ? $focus{$a[3]}  : "Unknown($a[3]",
                );
            },
        },

        0x041e => { # AF area selector
            Name => 'AFAreaSelector',
            Writable => 'int8u',
            Count => 1,
            PrintConv => {
                0 => 'Tracking',
                1 => 'Spot',
                3 => 'Large or Multi Zone',
            },
        },

        0x044d => { # AF point center
            Name => 'AFPointPosition',
            Writable => 'rational64s',
            Count => 2,
            Notes => 'X Y coordinates of primary AF point center, normalized to 0.0 to 1.0',
            PrintConv => q{
                return 'n/a' if $val eq '-1/1024 -1/1024';
                return $val;
            },
        },
    },

    'Image::ExifTool::Unknown::Main' => {

        0x0017 => { # Hasselblad X2D II 100C - focus mode
            Name => 'FocusMode',
            Writable => 'int8u',
            Count => 17,
            Notes => 'Focus mode is byte 1: 0x42 = AF-S, 0x82 = AF-C, 0x02 = MF',
            ValueConv => 'unpack("C", substr($val,1,1))',
            PrintConv => {
                0x42 => 'AF-S',
                0x82 => 'AF-C',
                0x02 => 'MF',
            },
        },

        0x0047 => { # Hasselblad X2D II 100C - AF box
            Name => 'FocusArea',
            Writable => 'int16u',
            Count => 7,
            Notes => 'AF box: [0] = count, [1] = center X, [2] = center Y, [3] = width, [4] = height; coordinates normalized to 0-10000',
        },

        0x004b => { # Hasselblad X2D II 100C - focus point mode
            Name => 'FocusPointMode',
            Writable => 'int8u',
            Count => 829,
            Notes => 'Focus point mode is byte 805: 0 = Spot, 2 = Wide, 3 = Expanded Spot, 5 = Custom',
            ValueConv => 'unpack("C", substr($val,805,1))',
            PrintConv => {
                0 => 'Spot',
                2 => 'Wide',
                3 => 'Expanded Spot',
                5 => 'Custom',
            },
        },

        0x0079 => { # Hasselblad X2D II 100C - multi-subject flag
            Name => 'MultiSubject',
            Writable => 'int8u',
            Count => 8,
            Notes => 'Byte 0: 0 = single subject, 1 = multiple subjects detected',
            ValueConv => 'unpack("C", $val)',
            PrintConv => {
                0 => 'No',
                1 => 'Yes',
            },
        },
    },

);

1;  # Important: must return true